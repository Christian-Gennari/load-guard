#!/usr/bin/env bash
# lg — load guard. Keeps a shared Linux machine from running out of memory when several
# agents or workers run builds and tests at once: an admission gate for workers, shared
# slots with cgroup limits for heavy commands, a memory watchdog and a live dashboard.
# https://github.com/Christian-Gennari/load-guard · MIT license
# Config: ~/.config/load-guard.conf (shell KEY=VALUE lines, see config.example.conf).
set -uo pipefail
LG_VERSION=1.5.0

CONF="${LG_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/load-guard.conf}"
# shellcheck disable=SC1090
[[ -f "$CONF" ]] && . "$CONF"

# ---- defaults: only for keys that the config file or the environment did not set ----
_cores=${LG_TEST_CORES:-$(nproc)}
_ram_gb=${LG_TEST_RAM_GB:-$(awk '/^MemTotal:/{printf "%.1f", $2/1048576}' /proc/meminfo)}
unset LG_TEST_CORES LG_TEST_RAM_GB   # test-only overrides, not part of `lg config`
_pick() { awk -v r="$_ram_gb" -v f="$1" -v lo="$2" -v hi="$3" 'BEGIN{v=r*f; if(v<lo)v=lo; if(v>hi)v=hi; printf "%g", int(v*2+0.5)/2}'; }
_to_gb() { awk -v v="$1" 'BEGIN{u=toupper(substr(v,length(v),1)); n=v
  if(u~/^[KMGT]$/){n=substr(v,1,length(v)-1)}else{u="G"}
  m=(u=="K")?1/1048576:(u=="M")?1/1024:(u=="T")?1024:1
  printf "%.4f", (n+0)*m}'; }
_heavy_default() {
  awk -v r="$_ram_gb" -v f="$LG_MIN_FREE_GB" -v j="$(_to_gb "$LG_JOB_MEM")" -v c="$_cores" 'BEGIN{
    if (j <= 0) j = 1
    cap = int(c / 4); if (cap < 1) cap = 1; if (cap > 8) cap = 8
    n = int((r - f) / j); if (n < 1) n = 1; if (n > cap) n = cap
    printf "%d", n}'
}
: "${LG_MIN_FREE_GB:=$(_pick 0.25 1 4)}"      # free memory (MemAvailable) to admit a worker
: "${LG_HEAVY_FREE_GB:=$LG_MIN_FREE_GB}"      # free memory to start a heavy job
: "${LG_KILL_FREE_GB:=$(_pick 0.1 0.5 1.5)}"  # watchdog stops the newest heavy job below this
: "${LG_MAX_LOAD:=$(( _cores * 4 / 3 ))}"     # 1-min load ceiling to admit a worker
: "${LG_HEAVY_MAX_LOAD:=$_cores}"             # 1-min load ceiling to start a heavy job
: "${LG_MAX_PSI:=5}"                          # memory pressure ceiling (% of time stalled, some avg10)
: "${LG_JOB_MEM:=$(_pick 0.3 1 4)G}"          # MemoryMax per heavy job
# The two concurrency limits follow from the machine, the memory a heavy job may take and the free-memory floor.
: "${LG_MAX_HEAVY:=$(_heavy_default)}"        # heavy jobs (lg run: builds, tests) at once, machine-wide
_w=$(( LG_MAX_HEAVY + 1 )); (( _w < 2 )) && _w=2; (( _w > 8 )) && _w=8
: "${LG_MAX_WORKERS:=$_w}"                    # parallel workers (agents) at once
: "${LG_MAX_HEAVY_TOTAL:=$((LG_MAX_HEAVY + 1))}"  # lg jobs + CI runner jobs at once
: "${LG_JOB_SWAP:=256M}"                      # MemorySwapMax per heavy job (stops swap thrash)
: "${LG_JOB_CPU:=$(( (_cores + 2) / 3 * 100 ))%}"  # CPUQuota per heavy job (100% = 1 core)
: "${LG_JOB_NICE:=10}"
: "${LG_EXCLUSIVE_MATCH:=}"                   # glob: commands that may run only one at a time (e.g. '*dotnet test*')
_excl_mem_set=$([[ -n ${LG_EXCLUSIVE_MEM:-} ]] && echo 1 || echo 0)
: "${LG_EXCLUSIVE_MEM:=$LG_JOB_MEM}"           # MemoryMax of an exclusive job; it takes LG_EXCLUSIVE_MEM / LG_JOB_MEM slots
: "${LG_EXCLUSIVE_UNLESS:=}"                  # glob: ... except when they also match this (e.g. '*--filter*')
: "${LG_CI_PROCESS:=Runner.Worker}"           # process name of a CI job (GitHub Actions self-hosted runner)
: "${LG_WATCH_INTERVAL:=10}"                  # watchdog poll seconds
: "${LG_POLL:=30}"                            # queue re-check seconds
: "${LG_WAIT_MAX:=5400}"                      # max seconds to wait in a queue (90 min)
: "${LG_STALE_HOURS:=8}"                      # worker registrations older than this are ignored
: "${LG_KEEP_DAYS:=14}"                       # the watchdog deletes metrics and events older than this (days)
: "${LG_METRICS_EVERY:=60}"                   # watchdog writes one metrics line this often (seconds)
: "${LG_DASH_PORT:=8377}"                     # live dashboard port (lg dashboard)
: "${LG_DASH_BIND:=127.0.0.1}"                # dashboard listen address
: "${LG_DASH_INTERVAL:=2}"                    # dashboard sample seconds (no samples while no browser is connected)
: "${LG_DASH_ALLOW_WRITE:=0}"                 # 1 = allow the dashboard Settings view to change the limits from any address
export LG_CONF="$CONF"

STATE="${XDG_CACHE_HOME:-$HOME/.cache}/load-guard"
JOBS="$STATE/jobs"; WORKERS="$STATE/workers"; SLOTS="$STATE/slots"; LOG="$STATE/events.log"; METRICS="$STATE/metrics.log"
QUEUE="$STATE/queue"
mkdir -p "$JOBS" "$WORKERS" "$SLOTS" "$QUEUE"

EX_TEMPFAIL=75

log() { { flock -w 2 9; printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; } 9>>"$STATE/log.lock"; }

# Keep LG_KEEP_DAYS of metrics and events. Only the watchdog writes metrics; event writers hold log.lock.
trim_logs() {
  local cut; cut=$(( $(date +%s) - LG_KEEP_DAYS * 86400 ))
  if [[ -s $METRICS ]] && (( $(head -c 20 "$METRICS" | cut -d' ' -f1) < cut )) 2>/dev/null; then
    awk -v c="$cut" '$1 >= c' "$METRICS" >"$METRICS.tmp" && mv -f "$METRICS.tmp" "$METRICS"
  fi
  local cutd; cutd=$(date -d "@$cut" '+%F %T')
  if [[ -s $LOG && "$(head -c 19 "$LOG")" < "$cutd" ]]; then
    { flock -w 10 9 && awk -v c="$cutd" 'substr($0, 1, 19) >= c' "$LOG" >"$LOG.tmp" && mv -f "$LOG.tmp" "$LOG"; } 9>>"$STATE/log.lock"
  fi
  find "$STATE/killed" -type f -mtime +1 -delete 2>/dev/null
}
say() { printf 'load-guard: %s\n' "$*" >&2; }

# ---- metrics ----
free_kb()  { awk '/^MemAvailable:/{print $2}' /proc/meminfo; }
swap_used_kb() { awk '/^SwapTotal:/{t=$2}/^SwapFree:/{f=$2}END{print t-f}' /proc/meminfo; }
load1()    { cut -d' ' -f1 /proc/loadavg; }
psi_mem()  { awk '/^some/{split($2,a,"=");print a[2]}' /proc/pressure/memory 2>/dev/null || echo 0; }
gb()       { awk -v k="$1" 'BEGIN{printf "%.1f", k/1048576}'; }
ge()       { awk -v a="$1" -v b="$2" 'BEGIN{exit !(a>=b)}'; }   # a >= b (floats)
gb_to_kb() { awk -v g="$1" 'BEGIN{printf "%d", g*1048576}'; }

# ---- registries ----
prune_jobs() {
  local f unit
  for f in "$JOBS"/*.job; do
    [[ -e "$f" ]] || continue
    unit=$(basename "$f" .job)
    systemctl --user is-active --quiet "$unit.scope" 2>/dev/null || rm -f "$f"
  done
}
# Slots in use: a job file says slot=1, or slot=1+2 for a job that takes two slots.
heavy_count() {
  prune_jobs
  local f s n=0
  for f in "$JOBS"/*.job; do
    [[ -e $f ]] || continue
    s=$(sed -n '1s/^[^ ]* slot=\([^ ]*\) .*/\1/p' "$f"); s=${s//[!+]/}
    n=$(( n + ${#s} + 1 ))
  done
  # slots that a waiting multi-slot job already holds (held.<pid> = how many)
  for f in "$SLOTS"/held.*; do
    [[ -e $f ]] || continue
    if kill -0 "${f##*.}" 2>/dev/null; then n=$(( n + $(cat "$f" 2>/dev/null || echo 0) )); else rm -f "$f"; fi
  done
  echo "$n"
}
# CI jobs on this machine (for example self-hosted GitHub Actions runners) count as heavy jobs.
runner_count() { [[ -n $LG_CI_PROCESS ]] || { echo 0; return; }; pgrep -c -x "$LG_CI_PROCESS" 2>/dev/null || true; }
worker_count() {
  find "$WORKERS" -name '*.w' -mmin -"$((LG_STALE_HOURS * 60))" | wc -l
}

# ---- checks: prints reasons, returns 0 when all pass ----
check() {  # $1 = worker|heavy — prints one plain reason per failed check; returns 0 when all pass
  local mode=$1 ok=0 f l p need what
  f=$(free_kb); l=$(load1); p=$(psi_mem)
  what=$([[ $mode == worker ]] && echo "a new worker" || echo "a new build or test")
  need=$([[ $mode == worker ]] && echo "$LG_MIN_FREE_GB" || echo "$LG_HEAVY_FREE_GB")
  if ! ge "$f" "$(gb_to_kb "$need")"; then echo "memory is low: $(gb "$f") GB free, $what needs $need GB"; ok=1; fi
  local maxl=$([[ $mode == worker ]] && echo "$LG_MAX_LOAD" || echo "$LG_HEAVY_MAX_LOAD")
  if ge "$l" "$maxl" && [[ $l != "$maxl" ]]; then echo "the CPU is busy: load $l, limit $maxl"; ok=1; fi
  if ge "$p" "$LG_MAX_PSI" && [[ $p != "$LG_MAX_PSI" ]]; then echo "programs wait for memory $p% of the time, limit $LG_MAX_PSI%"; ok=1; fi
  if [[ $mode == heavy ]]; then
    local r t; r=$(runner_count); t=$(( $(heavy_count) + r ))
    if (( t >= LG_MAX_HEAVY_TOTAL )); then echo "$t of $LG_MAX_HEAVY_TOTAL builds and tests run already$( (( r )) && echo " ($r of them CI jobs)")"; ok=1; fi
  fi
  if [[ $mode == worker ]]; then
    local w names; w=$(worker_count)
    if (( w >= LG_MAX_WORKERS )); then
      names=$(find "$WORKERS" -name '*.w' -mmin -"$((LG_STALE_HOURS * 60))" -printf '%f\n' | sed 's/\.w$//' | head -3 | paste -sd, | sed 's/,/, /g')
      echo "all $LG_MAX_WORKERS worker seats are taken ($names)"; ok=1
    fi
  fi
  return $ok
}

# check heavy plus the slot count: can a new `lg run` start now?
check_heavy_now() {
  local why
  if ! why=$(check heavy); then echo "$why"; return 1; fi
  if (( $(heavy_count) >= LG_MAX_HEAVY )); then echo "all $LG_MAX_HEAVY build and test slots are in use"; return 1; fi
}

# ---- queue registry: one file per waiting lg process, shown by the dashboard ----
QSINCE=""
queue_set() {  # kind(worker|heavy) reasons command
  [[ -n $QSINCE ]] || { QSINCE=$(date +%s); trap 'rm -f "$QUEUE/$$.q" "$SLOTS/held.$$"' EXIT; }
  printf '%s\t%s\t%s\t%s\t%s\n' "$QSINCE" "$1" "$(echo "$2" | paste -sd';')" "$PWD" "$3" >"$QUEUE/$$.q"
}
queue_clear() { rm -f "$QUEUE/$$.q"; }

# ---- commands ----
cmd_status() {
  local json=0; [[ ${1:-} == --json ]] && json=1
  local f s l p h w
  f=$(free_kb); s=$(swap_used_kb); l=$(load1); p=$(psi_mem); h=$(heavy_count); w=$(worker_count)
  local ww hw aw=true ah=true
  ww=$(check worker | paste -sd';') ; [[ -z $ww ]] || aw=false
  hw=$(check_heavy_now | paste -sd';'); [[ -z $hw ]] || ah=false
  if (( json )); then ww=${ww//\\/\\\\}; ww=${ww//\"/\\\"}; hw=${hw//\\/\\\\}; hw=${hw//\"/\\\"}; fi   # JSON-escape the reasons
  if (( json )); then
    printf '{"free_gb":%s,"swap_used_gb":%s,"load1":%s,"cores":%s,"psi_mem_avg10":%s,"heavy":%s,"max_heavy":%s,"workers":%s,"max_workers":%s,"admit_worker":%s,"worker_wait":"%s","admit_heavy":%s,"heavy_wait":"%s","runners":%s,"max_heavy_total":%s}\n' \
      "$(gb "$f")" "$(gb "$s")" "$l" "$(nproc)" "$p" "$h" "$LG_MAX_HEAVY" "$w" "$LG_MAX_WORKERS" \
      "$aw" "$ww" "$ah" "$hw" "$(runner_count)" "$LG_MAX_HEAVY_TOTAL"
    return
  fi
  printf 'free %s GB | swap used %s GB | load %s / %s cores | mem pressure %s%%\n' "$(gb "$f")" "$(gb "$s")" "$l" "$(nproc)" "$p"
  printf 'heavy jobs %s/%s | CI runner jobs %s (total cap %s) | workers %s/%s\n' "$h" "$LG_MAX_HEAVY" "$(runner_count)" "$LG_MAX_HEAVY_TOTAL" "$w" "$LG_MAX_WORKERS"
  local x
  for x in "$JOBS"/*.job; do [[ -e $x ]] && printf '  job    %s\n' "$(cat "$x")"; done
  for x in "$WORKERS"/*.w; do [[ -e $x ]] && printf '  worker %s  (since %s)\n' "$(basename "$x" .w)" "$(date -r "$x" '+%H:%M')"; done
  if [[ $aw == true ]]; then echo "new worker: ADMIT"; else echo "new worker: WAIT ($ww)"; fi
  if [[ $ah == true ]]; then echo "new heavy job: ADMIT"; else echo "new heavy job: WAIT ($hw)"; fi
  if pgrep -f 'lg watchdog' >/dev/null || systemctl --user is-active --quiet load-guard-watchdog 2>/dev/null; then
    echo "watchdog: running"; else echo "watchdog: NOT running (lg watchdog --install)"; fi
  if systemctl --user is-active --quiet load-guard-dashboard 2>/dev/null; then echo "dashboard: $(dashboard_url)"; fi
}

cmd_admit() {  # [--wait] [--for <worker name>] [--override "<reason>"] — each decision goes to the event log
  local wait=0 for="" over="" start=$SECONDS why logged=0
  while [[ $# -gt 0 ]]; do case $1 in --wait) wait=1; shift;; --for) for=${2:-}; shift 2;; --override) over=${2:-}; shift 2;; *) shift;; esac; done
  while ! why=$(check worker); do
    why=$(echo "$why" | paste -sd';')
    if [[ -n $over ]]; then   # the agent decides to start anyway; people see this in the activity feed
      over=${over//[$'\n\t']/ }; log "admit OVERRIDE for=${for:--} reason=$over was=$why"
      echo "ADMIT (override: the limits said wait: ${why//;/; })"; return 0
    fi
    (( logged )) || { log "admit WAIT for=${for:--} why=$why"; logged=1; }
    if (( ! wait )); then echo "WAIT: ${why//;/; }. It can start when other work ends or memory frees up."; return 1; fi
    if (( SECONDS - start > LG_WAIT_MAX )); then echo "TIMEOUT after ${LG_WAIT_MAX}s: $why"; return $EX_TEMPFAIL; fi
    queue_set worker "$why" "lg admit --wait${for:+ --for $for}"
    say "queued worker: $why"; sleep "$LG_POLL"
  done
  queue_clear
  log "admit ADMIT for=${for:--}"
  echo "ADMIT"
}

cmd_worker() {  # start <name> [task…] | end <name> | touch <name> | list
  local sub=${1:-list} name=${2:-} task="${*:3}" f
  case $sub in
    start) [[ -n $name ]] || { say "usage: lg worker start <name> [task description]"; return 2; }
           task=${task//[$'\n\t']/ }; printf '%s\n' "$task" >"$WORKERS/$name.w"
           log "worker start $name${task:+ task=$task}";;
    end)   rm -f "$WORKERS/$name.w"; log "worker end $name";;
    touch) touch "$WORKERS/$name.w";;
    list)  for f in "$WORKERS"/*.w; do [[ -e $f ]] && printf '%s\t%s\n' "$(basename "$f" .w)" "$(head -1 "$f")"; done;;
    *) say "usage: lg worker start <name> [task] | end <name> | touch <name> | list"; return 2;;
  esac
}

cmd_run() {  # [--mem X] [--cpu Y%] [--] cmd...
  local mem=$LG_JOB_MEM cpu=$LG_JOB_CPU mem_set=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --mem) mem=$2; mem_set=1; shift 2;; --cpu) cpu=$2; shift 2;;
      --) shift; break;; *) break;;
    esac
  done
  [[ $# -gt 0 ]] || { say "usage: lg run [--mem 3G] [--cpu 400%] -- <command...>"; return 2; }

  local start=$SECONDS fd slot="" i why sfd="" need
  local -a slots=() fds=()
  local cmdline="${*//[$'\n\t']/ }"   # one line for the job file, the event log and the queue
  # Commands that match LG_EXCLUSIVE_MATCH (for example a full test suite) run one at a time machine-wide.
  # shellcheck disable=SC2053
  if [[ -n $LG_EXCLUSIVE_MATCH && $cmdline == $LG_EXCLUSIVE_MATCH && ( -z $LG_EXCLUSIVE_UNLESS || $cmdline != $LG_EXCLUSIVE_UNLESS ) ]]; then
    (( mem_set )) || mem=$LG_EXCLUSIVE_MEM
    exec {sfd}>"$SLOTS/exclusive.lock"
    until flock -n "$sfd"; do
      if (( SECONDS - start > LG_WAIT_MAX )); then say "gave up after ${LG_WAIT_MAX}s: another exclusive job runs"; return $EX_TEMPFAIL; fi
      queue_set heavy "another exclusive job runs (LG_EXCLUSIVE_MATCH)" "$cmdline"
      say "queued: another exclusive job runs (LG_EXCLUSIVE_MATCH) — retry in ${LG_POLL}s"; sleep "$LG_POLL"
    done
  fi
  # Each slot stands for LG_JOB_MEM of memory: a job with a larger limit takes more slots, so the
  # limits of all running jobs together never exceed LG_MAX_HEAVY x LG_JOB_MEM.
  need=$(awk -v m="$(_to_gb "$mem")" -v j="$(_to_gb "$LG_JOB_MEM")" -v n="$LG_MAX_HEAVY" 'BEGIN{
    k = (j > 0) ? int(m / j) : 1; if (j > 0 && k * j < m - 1e-9) k++; if (k < 1) k = 1; if (k > n) k = n; print k}')
  while :; do
    if why=$(check heavy); then
      # Keep the slots already taken while waiting for the rest, so a big job is not starved by small ones.
      for ((i = 1; i <= LG_MAX_HEAVY && ${#slots[@]} < need; i++)); do
        [[ " ${slots[*]} " == *" $i "* ]] && continue
        exec {fd}>"$SLOTS/$i.lock"
        if flock -n "$fd"; then slots+=("$i"); fds+=("$fd"); else exec {fd}>&-; fi
      done
      (( ${#slots[@]} >= need )) && { rm -f "$SLOTS/held.$$"; break; }
      if (( ${#slots[@]} )); then echo "${#slots[@]}" >"$SLOTS/held.$$"; fi
      if (( need > 1 )); then why="this job needs $need of the $LG_MAX_HEAVY build and test slots (memory $mem); it holds ${#slots[@]}"
      else why="all $LG_MAX_HEAVY build and test slots are in use"; fi
    fi
    if (( SECONDS - start > LG_WAIT_MAX )); then say "gave up after ${LG_WAIT_MAX}s: $why"; return $EX_TEMPFAIL; fi
    queue_set heavy "$why" "$cmdline"
    say "queued: $(echo "$why" | paste -sd';') — retry in ${LG_POLL}s"; sleep "$LG_POLL"
  done
  queue_clear
  slot=$(printf '%s\n' "${slots[@]}" | sort -n | paste -sd+)

  local unit="lg-$(date +%s)-$RANDOM" t0=$SECONDS peakf="$STATE/peak.$$"
  printf '%s slot=%s mem=%s cpu=%s cwd=%s cmd=%s\n' "$(date '+%H:%M:%S')" "$slot" "$mem" "$cpu" "$PWD" "$cmdline" >"$JOBS/$unit.job"
  log "start $unit slot=$slot cwd=$PWD cmd=$cmdline"
  say "running in $unit (slot $slot, mem $mem, cpu $cpu)"
  systemd-run --user --scope --quiet --unit="$unit" --collect \
    -p MemoryMax="$mem" -p MemorySwapMax="$LG_JOB_SWAP" -p CPUQuota="$cpu" --nice="$LG_JOB_NICE" \
    --setenv=LOAD_GUARD=1 -- bash -c 'cg=/sys/fs/cgroup$(cut -d: -f3 /proc/self/cgroup); pf=$1; shift
      "$@"; rc=$?; cat "$cg/memory.peak" >"$pf" 2>/dev/null; exit $rc' _ "$peakf" "$@"
  local rc=$? peak="limit"
  [[ -s $peakf ]] && peak="$(( $(cat "$peakf") / 1048576 ))MB"; rm -f "$peakf"
  local stats="rc=$rc dur=$((SECONDS - t0))s peak=$peak"
  for fd in "${fds[@]}"; do flock -u "$fd"; exec {fd}>&-; done
  [[ -n $sfd ]] && { flock -u "$sfd"; exec {sfd}>&-; }
  rm -f "$JOBS/$unit.job"
  if [[ -f "$STATE/killed/$unit" ]]; then
    rm -f "$STATE/killed/$unit"; log "end $unit $stats (stopped by watchdog)"
    say "STOPPED BY LOAD GUARD: the server ran low on memory. Wait, then run the same command again."
    return $EX_TEMPFAIL
  fi
  if (( rc == 137 )) || systemctl --user show "$unit.scope" -p Result 2>/dev/null | grep -q oom; then
    say "the command hit its memory limit ($mem). Run fewer tests at once or a narrower test target."
  fi
  log "end $unit $stats cmd=$cmdline"
  return $rc
}

cmd_watchdog() {
  if [[ ${1:-} == --install ]]; then
    local self; self=$(readlink -f "$0")
    mkdir -p "$HOME/.config/systemd/user"
    cat >"$HOME/.config/systemd/user/load-guard-watchdog.service" <<EOF
[Unit]
Description=load guard memory watchdog (stops the newest lg run job when memory is low)

[Service]
ExecStart=$self watchdog
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload && systemctl --user enable --now load-guard-watchdog.service
    systemctl --user --no-pager status load-guard-watchdog.service | head -4
    return
  fi
  mkdir -p "$STATE/killed"
  log "watchdog started (kill below $LG_KILL_FREE_GB GB free)"
  local kill_kb newest f info last=0 trimmed=-3600
  kill_kb=$(gb_to_kb "$LG_KILL_FREE_GB")
  while :; do
    if (( SECONDS - trimmed >= 3600 )); then trimmed=$SECONDS; trim_logs; fi
    if (( SECONDS - last >= LG_METRICS_EVERY )); then
      last=$SECONDS
      printf '%s %s %s %s %s %s %s %s\n' "$(date +%s)" "$(gb "$(free_kb)")" "$(gb "$(swap_used_kb)")" "$(load1)" "$(psi_mem)" "$(heavy_count)" "$(worker_count)" "$(runner_count)" >>"$METRICS"
    fi
    if ! ge "$(free_kb)" "$kill_kb"; then
      prune_jobs
      newest=$(ls -1t "$JOBS"/*.job 2>/dev/null | head -1)
      if [[ -n $newest ]]; then
        f=$(basename "$newest" .job); info=$(cat "$newest" 2>/dev/null)
        touch "$STATE/killed/$f"
        systemctl --user kill --signal=SIGKILL "$f.scope" 2>/dev/null
        log "WATCHDOG stopped $f: free $(gb "$(free_kb)") GB < $LG_KILL_FREE_GB GB ($info)"
        sleep 20   # let memory settle before judging again
      else
        log "WATCHDOG low memory ($(gb "$(free_kb)") GB) but no lg run job to stop"
        sleep 60
      fi
    fi
    sleep "$LG_WATCH_INTERVAL"
  done
}

cmd_report() {  # [hours] — summary of metrics and jobs for tuning the limits
  local h=${1:-24} since; since=$(( $(date +%s) - h * 3600 ))
  echo "== last ${h}h (metrics: epoch free_gb swap_gb load1 psi heavy workers runners)"
  awk -v s="$since" '$1>=s{n++; if(n==1||$2<mf)mf=$2; if($3>ms)ms=$3; if($4>ml)ml=$4; if($5>mp)mp=$5; if($6>mh)mh=$6; if($7>mw)mw=$7; if($8>mr)mr=$8; if($2<4)low++}
    END{if(!n){print "no metrics yet";exit} printf "samples %d | min free %.1f GB | max swap %.1f GB | max load %s | max psi %s%% | max heavy %d | max workers %d | max CI runner jobs %d | minutes under 4 GB free: %d\n",n,mf,ms,ml,mp,mh,mw,mr+0,low+0}' "$METRICS" 2>/dev/null
  echo "== watchdog actions"; grep -c WATCHDOG "$LOG" 2>/dev/null; grep WATCHDOG "$LOG" 2>/dev/null | tail -5
  echo "== heavy jobs (end events)"; grep ' end lg-' "$LOG" 2>/dev/null | tail -n 40
}

cmd_tune() {  # [hours] [--apply] — suggest limits from the last N hours of measurements and job history
  local h=24 apply=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --apply) apply=1; shift;;
      ''|*[!0-9]*) say "usage: lg tune [hours] [--apply]"; return 2;;
      *) h=$1; shift;;
    esac
  done
  (( 10#$h > 0 )) || { say "usage: lg tune [hours] [--apply]"; return 2; }
  local dir; dir=$(dirname "$(dirname "$(readlink -f "$0")")")/dashboard
  LG_MIN_FREE_GB=$LG_MIN_FREE_GB LG_HEAVY_FREE_GB=$LG_HEAVY_FREE_GB LG_CORES=$_cores \
    LG_EXCLUSIVE_MATCH=$LG_EXCLUSIVE_MATCH LG_EXCLUSIVE_UNLESS=$LG_EXCLUSIVE_UNLESS \
    LG_EXCLUSIVE_MEM=$LG_EXCLUSIVE_MEM LG_EXCLUSIVE_MEM_SET=$_excl_mem_set python3 - "$h" "$apply" "$METRICS" "$LOG" "$CONF" "$LG_JOB_MEM" "$LG_MAX_HEAVY" "$LG_MAX_WORKERS" "$_ram_gb" "$dir" <<'PY'
import fnmatch, math, os, re, subprocess, sys, time

hours = float(sys.argv[1])
apply = sys.argv[2] == "1"
metrics_path, log_path, conf_path = sys.argv[3:6]
job_mem_raw, max_heavy, max_workers = sys.argv[6:9]
ram_gb = float(sys.argv[9] or 0)
dashboard = sys.argv[10]


def to_gb(text):
    m = re.match(r"^([0-9]+(?:\.[0-9]+)?)([KMGT]?)$", text.strip(), re.I)
    if not m:
        return 0.0
    n, unit = float(m.group(1)), (m.group(2) or "G").upper()
    return n / 1048576 if unit == "K" else n / 1024 if unit == "M" else n * 1024 if unit == "T" else n


def fmt_gb(v):
    return f"{int(v)}G" if abs(v - int(v)) < 1e-9 else f"{v:.1f}G"


# ---- metrics: epoch free_gb swap_gb load1 psi heavy workers runners ----
since = time.time() - hours * 3600
free, parallel, free_full = [], [], []  # free_full: free memory while every heavy slot was taken
try:
    with open(metrics_path, errors="replace") as f:
        for line in f:
            p = line.split()
            if len(p) < 6:
                continue
            try:
                t = float(p[0])
                if t < since:
                    continue
                free.append(float(p[1]))
                runners = int(float(p[7])) if len(p) > 7 else 0
                parallel.append(int(float(p[5])) + runners)
                if int(float(p[5])) >= int(max_heavy):
                    free_full.append(float(p[1]))
            except ValueError:
                continue
except OSError:
    pass
if len(free) < 60:
    print(f"Not enough data yet: {len(free)} minutes of measurements. "
          "Use the machine normally for a day, then run lg tune again.")
    sys.exit(0)

min_free, max_parallel = min(free), max(parallel)

# ---- event log: finished jobs and watchdog actions ----
# Exclusive jobs (LG_EXCLUSIVE_MATCH, for example a full test suite) run one at a time with their own
# limit, so their peaks are kept apart from the normal jobs that share the slots.
excl_match = os.environ.get("LG_EXCLUSIVE_MATCH") or ""
excl_unless = os.environ.get("LG_EXCLUSIVE_UNLESS") or ""
excl_mem_raw = os.environ.get("LG_EXCLUSIVE_MEM") or job_mem_raw
excl_explicit = os.environ.get("LG_EXCLUSIVE_MEM_SET") == "1"


def is_excl(cmd):
    return bool(excl_match) and fnmatch.fnmatchcase(cmd, excl_match) and not (
        excl_unless and fnmatch.fnmatchcase(cmd, excl_unless))


stops = lows = jobs = 0
peaks = {False: [], True: []}  # is exclusive -> peak MB
hits = {False: 0, True: 0}
job_mem_gb, excl_mem_gb = to_gb(job_mem_raw), to_gb(excl_mem_raw)
EV_RE = re.compile(r"^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d) (.*)$")
END_RE = re.compile(r" rc=(-?\d+) dur=\d+s peak=(\S+)(?:.*? cmd=(.*))?$")
try:
    with open(log_path, errors="replace") as f:
        for line in f:
            m = EV_RE.match(line.rstrip("\n"))
            if not m:
                continue
            try:
                t = time.mktime(time.strptime(m.group(1), "%Y-%m-%d %H:%M:%S"))
            except ValueError:
                continue
            if t < since:
                continue
            text = m.group(2)
            if text.startswith("WATCHDOG stopped"):
                stops += 1
            elif text.startswith("WATCHDOG low"):
                lows += 1
            elif text.startswith("end lg-"):
                e = END_RE.search(text)
                if not e:
                    continue
                jobs += 1
                ex = is_excl(e.group(3) or "")
                rc = int(e.group(1))
                peak = re.match(r"(\d+)MB$", e.group(2))
                peak_mb = int(peak.group(1)) if peak else None
                if peak_mb is not None:
                    peaks[ex].append(peak_mb)
                limit = excl_mem_gb if ex else job_mem_gb
                if rc == 137 or (peak_mb is not None and peak_mb / 1024 >= limit * 0.95):
                    hits[ex] += 1
except OSError:
    pass


def ceil_half(v):
    return math.ceil(v * 2 - 1e-9) / 2


def floor_half(v):
    return math.floor(v * 2 + 1e-9) / 2


def pct(values, q):
    v = sorted(values)
    return v[min(len(v) - 1, int(len(v) * q))] if v else 0


# ---- suggestions: one plan in which the numbers fit together ----
# Budget: LG_MAX_HEAVY slots x LG_JOB_MEM must leave LG_MIN_FREE_GB free. A job with a larger limit
# (an exclusive job at LG_EXCLUSIVE_MEM) takes as many slots as its limit needs, so this always holds.
sugg = []  # (key, now, suggested, why)
notes = []
n_now = int(max_heavy)
floor_gb = float(os.environ.get("LG_MIN_FREE_GB") or 0)
budget = ram_gb - floor_gb
normal, excl = peaks[False], peaks[True]
heavy_free = float(os.environ.get("LG_HEAVY_FREE_GB") or floor_gb)
heavy_cap = min(8, max(1, int(os.environ.get("LG_CORES") or 1) // 4))  # same core cap as the default

# 1. slots
low = stops > 0 or min_free < 3
n = n_now
if low and n_now > 1:
    why = []
    if stops:
        why.append(f"{stops} watchdog stop{'s' if stops != 1 else ''}")
    if min_free < 3:
        why.append(f"free memory fell to {min_free:g} GB, below 3 GB")
    n = n_now - 1
    sugg.append(("LG_MAX_HEAVY", str(n_now), str(n), "; ".join(why)))
elif not low and free_full and len(free_full) >= len(free) * 0.1 and n_now < heavy_cap \
        and sum(free_full) / len(free_full) >= heavy_free + 2:
    # Slots were often all taken while memory sat free. One more slot only when most normal jobs
    # (90th percentile, 30 % headroom) still fit in the smaller share of the budget each slot gets.
    p90 = ceil_half(pct(normal, 0.9) / 1024 * 1.3) if len(normal) >= 5 else 1.0
    share = floor_half(budget / (n_now + 1))
    avg = sum(free_full) / len(free_full)
    if share >= max(1.0, p90):
        n = n_now + 1
        sugg.append(("LG_MAX_HEAVY", str(n_now), str(n),
                     f"all {n_now} slots were in use {100 * len(free_full) / len(free):.0f} % of the time "
                     f"with {avg:.1f} GB free on average"))
    else:
        notes.append(f"All {n_now} slots were often in use, but {n_now + 1} slots would give each job only "
                     f"{fmt_gb(share)}; most jobs need {fmt_gb(p90)}.")

# 2. memory per normal job: what the jobs used, but never more than the slot's share of the budget
share = floor_half(budget / n) if budget > 0 else 0
job_new = job_mem_gb
why = []
if hits[False]:
    job_new = job_mem_gb + 1
    why.append(f"{hits[False]} job{'s' if hits[False] != 1 else ''} hit the memory limit")
elif len(normal) >= 5:
    job_new = ceil_half(max(normal) / 1024 * 1.3)
    why.append(f"jobs peaked at {max(normal)} MB; with 30 % headroom that is {fmt_gb(job_new)}")
if share >= 1 and job_new > share:
    over = sum(1 for p in normal if p / 1024 > share * 0.95)
    if over:
        notes.append(f"{over} of {len(normal)} jobs peaked near or above {fmt_gb(share)}. "
                     f"With {n} slots they may hit the limit. Run narrower tests, or fewer slots.")
    job_new = share
    why = [f"{n} slots x {fmt_gb(share)} must leave {floor_gb:g} GB of {ram_gb:g} GB free"]
job_new = max(1.0, job_new)
if abs(job_new - job_mem_gb) >= 0.5 - 1e-9 or job_mem_gb > share >= 1:
    sugg.append(("LG_JOB_MEM", job_mem_raw, fmt_gb(job_new), "; ".join(why)))

# 3. memory per exclusive job: it runs alone and takes several slots, up to all of them
if excl_match and (excl or excl_explicit):
    excl_new = excl_mem_gb
    why = ""
    if hits[True]:
        excl_new = excl_mem_gb + 1
        why = f"{hits[True]} full run{'s' if hits[True] != 1 else ''} hit the memory limit"
    elif excl:
        excl_new = ceil_half(max(excl) / 1024 * 1.3)
        why = f"full runs peaked at {max(excl)} MB; with 30 % headroom that is {fmt_gb(excl_new)}"
    excl_new = max(job_new, min(excl_new, n * job_new))
    after = excl_mem_gb if excl_explicit else job_new  # the value it has after these changes
    if abs(excl_new - after) >= 0.5 - 1e-9 or (not excl_explicit and excl_new != job_mem_gb):
        k = math.ceil(excl_new / job_new - 1e-9)
        sugg.append(("LG_EXCLUSIVE_MEM", excl_mem_raw, fmt_gb(excl_new),
                     f"{why + '; ' if why else ''}it takes {k} of {n} slots while it runs"))

if not any(k == "LG_MAX_HEAVY" for k, *_ in sugg) and not low and min_free >= 5 and max_parallel >= 2 \
        and stops == 0 and int(max_workers) < 8:
    sugg.append(("LG_MAX_WORKERS", str(int(max_workers)), str(min(8, int(max_workers) + 1)),
                 f"free memory stayed at {min_free:g} GB or more with {max_parallel} heavy jobs running"))

# ---- output ----
print(f"Last {hours:g}h: {len(free)} samples | min free {min_free:g} GB | "
      f"max parallel heavy {max_parallel} (heavy + CI runners)")
print(f"Watchdog: {stops} stops, {lows} low-memory warnings | finished jobs: {jobs}")
print(f"Job memory: max peak {max(normal, default=0)} MB"
      + (f", full runs {max(excl, default=0)} MB" if excl_match else "")
      + f" | {hits[False] + hits[True]} jobs hit the memory limit")
for note in notes:
    print("Note: " + note)
if not sugg:
    print(f"The limits fit the last {hours:g} hours. No change.")
    sys.exit(0)
print(f"{'setting':<14} {'now':>6} {'suggested':>10}  why")
for key, now, new, why in sugg:
    print(f"{key:<14} {now:>6} {new:>10}  {why}")
if not apply:
    print(f"Run lg tune --apply to write these to {conf_path}.")
    sys.exit(0)
sys.stdout.flush()
r = subprocess.run([sys.executable, os.path.join(dashboard, "lgconf.py"), "set", "--source", "lg tune"] +
                   [f"{key}={new}" for key, _, new, _ in sugg], capture_output=True, text=True)
if r.returncode != 0:
    sys.stderr.write(r.stderr)
    sys.exit(r.returncode)
if r.stdout.strip():
    print(r.stdout.strip())
print(f"Wrote {len(sugg)} setting{'s' if len(sugg) != 1 else ''} to {conf_path}.")
PY
}

dashboard_url() {
  local dns=""
  [[ $LG_DASH_BIND == 127.0.0.1 ]] && command -v tailscale >/dev/null && dns=$(tailscale status --json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2>/dev/null)
  if [[ -n $dns ]] && tailscale serve status 2>/dev/null | grep -q ":$LG_DASH_PORT "; then echo "https://$dns:$LG_DASH_PORT/"
  else echo "http://$LG_DASH_BIND:$LG_DASH_PORT/"; fi
}

cmd_dashboard() {  # [--install [--tailscale]|--uninstall|--url|--demo] — live web page: load, jobs, queue, workers, events
  local self dir svc="$HOME/.config/systemd/user/load-guard-dashboard.service"
  self=$(readlink -f "$0"); dir=$(dirname "$(dirname "$self")")/dashboard
  case ${1:-} in
    --install)
      mkdir -p "$(dirname "$svc")"
      cat >"$svc" <<EOF
[Unit]
Description=load guard live dashboard (samples only while a browser is connected)

[Service]
ExecStart=/usr/bin/env python3 $dir/server.py
Restart=always
RestartSec=5
MemoryMax=128M
Nice=5

[Install]
WantedBy=default.target
EOF
      systemctl --user daemon-reload && systemctl --user enable load-guard-dashboard.service && systemctl --user restart load-guard-dashboard.service
      if [[ ${2:-} == --tailscale ]]; then   # publish to your tailnet only (HTTPS, not the public internet)
        command -v tailscale >/dev/null || { say "tailscale is not installed"; return 1; }
        tailscale serve status 2>/dev/null | grep -q ":$LG_DASH_PORT " \
          || tailscale serve --bg --https="$LG_DASH_PORT" "http://127.0.0.1:$LG_DASH_PORT" >/dev/null \
          || say "could not set up Tailscale serve (try: sudo tailscale set --operator=\$USER)"
      fi
      echo "dashboard: $(dashboard_url)";;
    --uninstall)
      systemctl --user disable --now load-guard-dashboard.service 2>/dev/null; rm -f "$svc"; systemctl --user daemon-reload
      command -v tailscale >/dev/null && tailscale serve status 2>/dev/null | grep -q ":$LG_DASH_PORT " \
        && tailscale serve --https="$LG_DASH_PORT" off >/dev/null 2>&1
      echo "dashboard removed";;
    --url) dashboard_url;;
    "") exec python3 "$dir/server.py";;
    --demo) exec python3 "$dir/server.py" --demo;;
    *) say "usage: lg dashboard [--install [--tailscale]|--uninstall|--url|--demo]"; return 2;;
  esac
}

cmd_events() { if [[ ${1:-} == -f ]]; then tail -n 20 -F "$LOG"; else tail -n "${1:-30}" "$LOG" 2>/dev/null; fi; }

case ${1:-status} in
  status)   shift || true; cmd_status "$@";;
  admit)    shift; cmd_admit "$@";;
  worker)   shift; cmd_worker "$@";;
  run)      shift; cmd_run "$@";;
  watchdog) shift; cmd_watchdog "$@";;
  events)   shift; cmd_events "$@";;
  report)   shift; cmd_report "$@";;
  tune)     shift; cmd_tune "$@";;
  dashboard) shift; cmd_dashboard "$@";;
  config)   for v in ${!LG_@}; do echo "$v=${!v}"; done;;
  version|--version) echo "lg $LG_VERSION";;
  rules)    cat "$(dirname "$(dirname "$(readlink -f "$0")")")/rules/load-guard-rules.md";;
  -h|--help|help) sed -n '2,4p' "$0" | cut -c3-; echo "commands: status [--json] | admit [--wait] [--for name] [--override reason] | worker start <name> [task]|end|touch|list | run [--mem X] [--cpu Y%] -- cmd | watchdog [--install] | events [-f|N] | report [hours] | tune [hours] [--apply] | dashboard [--install [--tailscale]|--uninstall|--url|--demo] | rules | config | version";;
  *) say "unknown command: $1 (lg help)"; exit 2;;
esac
